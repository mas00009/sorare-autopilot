# Create these yourself at https://sorare.com/settings/developer
# (Claude cannot create them for you - it will not handle your password.)
SORARE_CLIENT_ID=
SORARE_CLIENT_SECRET=
SORARE_API_KEY=

# Optional: where the run summary gets pushed. Leave blank to log to stdout only.
AUTOPILOT_WEBHOOK_URL=

# Safety. Leave these exactly as they are unless you mean it.
ALLOW_GEM_SPEND=false
ALLOW_MONEY_SPEND=false
DRY_RUN=false

# Email reports. Create a Gmail App Password yourself at
# https://myaccount.google.com/apppasswords  (Claude will not handle it.)
SMTP_USER=
SMTP_APP_PASSWORD=
REPORT_TO=
